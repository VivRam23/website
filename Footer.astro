---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-10 lg:px-16">
    <p class="text-sm text-stone-600">© {year} Viviana Rames. All rights reserved.</p>
    <div class="flex items-center gap-6">
      <a href="/" class="text-sm text-ink/80 hover:text-ink">Home</a>
      {nav.map((item) => (
        <a href={item.href} class="text-sm text-ink/80 hover:text-ink">{item.label}</a>
      ))}
      <a href={site.linkedin} class="text-sm text-ink/80 hover:text-ink" rel="me noopener" target="_blank">
        LinkedIn
      </a>
      <a href={`mailto:${site.email}`} class="text-sm text-ink/80 hover:text-ink">
        {site.email}
      </a>
    </div>
  </div>
</footer>
