---
import { engagementModels } from '../data/site';
---

<section class="border-b border-ink/10 bg-cream-alt">
  <div class="section-inner section">
    <p class="eyebrow">How I work</p>
    <h2 class="mt-3 text-4xl sm:text-5xl">Different challenges need different levels of support</h2>

    <div class="mt-12 grid gap-8 sm:grid-cols-3">
      {engagementModels.map((model) => (
        <div class="border-t-2 border-olive pt-5">
          <h3 class="text-xl">{model.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink/75">{model.description}</p>
        </div>
      ))}
    </div>

    <p class="mt-12 max-w-2xl text-sm leading-relaxed text-stone-600">
      I take on fractional, project-based and interim work — and I'll also consider the right senior permanent role, when the fit is right.
    </p>
  </div>
</section>
