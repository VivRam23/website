---
import type { CaseStudy } from '../data/site';

export interface Props {
  cs: CaseStudy;
  index: number;
}

const { cs, index } = Astro.props;
---

<article id={cs.slug} class="scroll-mt-24 border-b border-grey-200 py-20 first:pt-0 lg:py-28">
  <div class="flex flex-wrap items-baseline gap-4">
    <span class="font-display text-sm font-bold text-orange">0{index + 1}</span>
    <span class="text-xs font-semibold uppercase tracking-widest2 text-grey-500">{cs.role}</span>
  </div>

  <h2 class="mt-5 max-w-3xl text-4xl leading-tight sm:text-5xl">{cs.theme}</h2>

  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
    <p class="text-sm font-semibold uppercase tracking-widest2 text-grey-500">
      {cs.tags.join(' / ')}
    </p>
    <a
      href={cs.url}
      target="_blank"
      rel="noopener"
      class="text-sm font-semibold text-ink underline decoration-orange decoration-2 underline-offset-4 hover:text-orange"
    >
      {cs.url.replace('https://', '')} ↗
    </a>
  </div>

  <div class="mt-14 grid gap-12 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-16">
    <div class="hidden lg:block lg:space-y-10">
      <p class="text-xs font-semibold uppercase tracking-widest2 text-grey-500">Context</p>
      <p class="text-xs font-semibold uppercase tracking-widest2 text-grey-500">Challenge</p>
      <p class="text-xs font-semibold uppercase tracking-widest2 text-grey-500">My role</p>
      <p class="text-xs font-semibold uppercase tracking-widest2 text-grey-500">Approach &amp; execution</p>
      <p class="text-xs font-semibold uppercase tracking-widest2 text-grey-500">Outcomes</p>
    </div>

    <div class="space-y-12 lg:space-y-14">
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest2 text-grey-500 lg:hidden">Context</p>
        <p class="max-w-2xl text-lg leading-relaxed text-ink">{cs.context}</p>
      </div>

      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest2 text-grey-500 lg:hidden">Challenge</p>
        <ul class="max-w-2xl space-y-2 text-base leading-relaxed text-grey-700">
          {cs.challenges.map((c) => (
            <li class="flex gap-3">
              <span class="mt-2.5 h-1 w-1 flex-none rounded-full bg-orange"></span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest2 text-grey-500 lg:hidden">My role</p>
        <p class="max-w-2xl text-base leading-relaxed text-grey-700">{cs.role_detail}</p>
      </div>

      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest2 text-grey-500 lg:hidden">Approach &amp; execution</p>
        <div class="space-y-8">
          {cs.approach.map((section) => (
            <div>
              <h3 class="text-lg font-semibold text-ink">{section.heading}</h3>
              <ul class="mt-3 max-w-2xl space-y-2 text-base leading-relaxed text-grey-700">
                {section.items.map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 h-1 w-1 flex-none rounded-full bg-grey-400"></span>
                    <span>{item.body}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest2 text-grey-500 lg:hidden">Outcomes</p>
        <ul class="max-w-2xl space-y-2 text-base leading-relaxed text-ink">
          {cs.outcomes.map((o) => (
            <li class="flex gap-3">
              <span class="mt-2.5 h-1 w-1 flex-none rounded-full bg-orange"></span>
              <span>{o}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-16">
    <p class="eyebrow">Examples of work</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-3">
      {cs.examples.map((ex) => (
        <figure>
          <img src={ex.image} alt={ex.alt} class="h-44 w-full border border-grey-200 object-cover" loading="lazy" />
          <figcaption class="mt-3">
            <p class="text-sm font-semibold text-ink">{ex.caption}</p>
            <p class="mt-1 text-sm leading-snug text-grey-600">{ex.description}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</article>
