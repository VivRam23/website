---
import { site } from '../data/site';
---

<section id="contact" class="scroll-mt-24 bg-ink">
  <div class="section-inner section text-center !py-20">
    <p class="text-xs font-semibold uppercase tracking-widest2 text-grey-400">Get started</p>
    <h2 class="mx-auto mt-4 max-w-2xl text-4xl leading-tight text-paper sm:text-5xl">
      Ready to turn your mission into <span class="text-orange">traction</span>?
    </h2>
    <div class="mt-8">
      <a href={`mailto:${site.email}`} class="btn-primary">Let's talk →</a>
    </div>
  </div>
</section>
