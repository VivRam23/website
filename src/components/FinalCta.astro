---
import { site } from '../data/site';
---

<section class="bg-olive-dark">
  <div class="section-inner section text-center !py-20">
    <p class="text-xs font-medium uppercase tracking-[0.14em] text-cream/60">Get started</p>
    <h2 class="mx-auto mt-4 max-w-2xl text-4xl leading-tight text-cream sm:text-5xl">
      Ready to turn your mission into traction?
    </h2>
    <div class="mt-8">
      <a href={`mailto:${site.email}`} class="btn-outline">Let's talk →</a>
    </div>
  </div>
</section>
