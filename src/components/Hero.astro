---
import HeroGraphic from './HeroGraphic.astro';
---

<section class="relative overflow-hidden border-b border-grey-200">
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: linear-gradient(to right, rgba(18,18,16,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(18,18,16,0.05) 1px, transparent 1px); background-size: 88px 88px;"
    aria-hidden="true"
  >
    <svg class="absolute inset-0 h-full w-full" xmlns="http://www.w3.org/2000/svg">
      <circle cx="616" cy="88" r="2.5" fill="none" stroke="rgba(18,18,16,0.16)" stroke-width="1" />
      <circle cx="880" cy="264" r="2.5" fill="none" stroke="rgba(18,18,16,0.16)" stroke-width="1" />
      <circle cx="1144" cy="176" r="2" fill="rgba(241,90,36,0.5)" />
    </svg>
  </div>

  <div class="section-inner relative z-10 grid gap-12 px-6 py-20 sm:px-10 lg:grid-cols-[3fr_2fr] lg:items-center lg:gap-8 lg:px-16 lg:py-28">
    <div class="max-w-2xl">
      <h1 class="text-4xl leading-[1.1] tracking-tight sm:text-5xl lg:text-[44px] xl:text-[52px]">
        <span class="block font-medium text-ink">
          Turn complex <span class="font-normal">into</span> <span class="font-black">clear.</span>
        </span>
        <span class="mt-1 block font-medium text-ink">
          Turn clear <span class="font-normal">into</span> <span class="font-black text-orange">traction.</span>
        </span>
      </h1>

      <p class="mt-8 max-w-xl text-lg leading-relaxed text-grey-700">
        I help companies position and take complex products and emerging technologies to market.
      </p>

      <p class="mt-6 text-xs font-semibold uppercase tracking-widest2 text-grey-500">
        Positioning / Product Marketing / GTM / Communications
      </p>
    </div>

    <div class="mx-auto w-full max-w-[240px] sm:max-w-[280px] lg:max-w-[300px]">
      <HeroGraphic />
    </div>
  </div>
</section>
