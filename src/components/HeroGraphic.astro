---
// Restrained abstract mark for the hero's right-hand column.
// A single vivid orange form, supported by a couple of fine near-black
// lines — deliberately small and quiet so it never competes with the
// headline. Not a chart, curve, arrow or diagram.
---

<svg
  viewBox="0 0 480 480"
  class="hero-graphic h-full w-full"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="A single abstract orange geometric form with fine supporting lines"
>
  <!-- one distinctive orange element -->
  <circle cx="322" cy="168" r="64" fill="#F05A28" />

  <!-- fine supporting lines -->
  <line x1="196" y1="238" x2="196" y2="330" stroke="#121210" stroke-width="1" opacity="0.22" />
  <line x1="196" y1="330" x2="284" y2="330" stroke="#121210" stroke-width="1" opacity="0.22" />
</svg>
