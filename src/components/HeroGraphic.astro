---
// Abstract geometric composition for the hero's right-hand column.
// Deliberately not a chart, curve, arrow or diagram — bold flat forms,
// asymmetric placement and negative space only.
---

<svg
  viewBox="0 0 480 480"
  class="hero-graphic h-full w-full"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Abstract geometric composition of overlapping rectangular and circular forms"
>
  <!-- large near-black form, cropped by the top edge -->
  <rect x="176" y="-40" width="248" height="300" fill="#121210" />

  <!-- thin cross-line for compositional tension -->
  <line x1="70" y1="60" x2="330" y2="430" stroke="#121210" stroke-width="1" opacity="0.18" />

  <!-- bold orange circle, cropped by the left and bottom edges -->
  <circle cx="70" cy="392" r="118" fill="#F05A28" />

  <!-- small outlined square, floating in negative space -->
  <rect x="352" y="322" width="56" height="56" fill="none" stroke="#121210" stroke-width="1.5" opacity="0.35" />
</svg>
