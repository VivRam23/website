---
import { site, nav } from '../data/site';
---

<header class="border-b border-grey-200">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5 sm:px-10 lg:px-16">
    <a href="/" class="font-display text-sm font-bold uppercase tracking-widest2 text-ink">
      Viviana Rames
    </a>
    <nav aria-label="Primary" class="flex items-center gap-8">
      <ul class="hidden items-center gap-8 sm:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-xs font-semibold uppercase tracking-widest2 text-grey-700 transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href="/#contact"
            class="text-xs font-semibold uppercase tracking-widest2 text-grey-700 transition-colors hover:text-ink"
          >
            Contact
          </a>
        </li>
      </ul>
      <a href={`mailto:${site.email}`} class="btn-primary !px-7 !py-3.5 text-sm uppercase tracking-wide">
        Let's talk
      </a>
    </nav>
  </div>
</header>
