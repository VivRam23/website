---
import { site, nav } from '../data/site';
---

<header class="border-b border-ink/10">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5 sm:px-10 lg:px-16">
    <a href="/" class="font-display text-lg font-semibold tracking-tight text-ink">
      Viviana Rames
    </a>
    <nav aria-label="Primary" class="flex items-center gap-8">
      <ul class="hidden items-center gap-8 sm:flex">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-ink/80 transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={`mailto:${site.email}`} class="btn-primary !px-5 !py-2.5 text-sm">
        Let's talk
      </a>
    </nav>
  </div>
</header>
