---
import type { PortfolioCase } from '../data/portfolio';
import PortfolioFigure from './PortfolioFigure.astro';

export interface Props {
  item: PortfolioCase;
  /** First case sits above the fold, so its lead image should not be lazy-loaded. */
  first?: boolean;
}

const { item, first = false } = Astro.props;
---

<article id={item.id} aria-labelledby={`${item.id}-title`} class="scroll-mt-24 border-b border-grey-200">
  <div class="section-inner section !py-12 lg:!py-16">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-16">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest2 text-ink">
          {item.company}
          {item.role && <span class="font-medium text-grey-600"> / {item.role}</span>}
        </p>
        <h2 id={`${item.id}-title`} class="mt-3 max-w-xl text-3xl leading-tight sm:text-4xl">{item.title}</h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-grey-700 sm:text-lg">{item.outcome}</p>
      </div>
      <PortfolioFigure image={item.lead} eager={first} />
    </div>

    <details class="case-details mt-8 lg:mt-10">
      <summary
        class="inline-flex cursor-pointer items-center gap-3 text-xs font-semibold uppercase tracking-widest2 text-ink transition-colors hover:text-orange"
      >
        <span class="chevron" aria-hidden="true"></span>
        <span class="label-open">{item.toggleLabel}</span>
        <span class="label-close">Close</span>
      </summary>

      <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <div class="space-y-8">
          {item.sections.map((section) => (
            <div>
              {section.label && (
                <h3 class="font-sans text-xs font-semibold uppercase tracking-widest2 text-grey-600">{section.label}</h3>
              )}
              {section.text && <p class="mt-2 max-w-xl text-base leading-relaxed text-grey-700">{section.text}</p>}
              {section.paragraphs && (
                <div class="max-w-xl space-y-4 text-base leading-relaxed text-grey-700">
                  {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              )}
              {section.items && (
                <ul class="mt-3 max-w-xl space-y-2">
                  {section.items.map((entry) => (
                    <li class="flex gap-3 text-base leading-relaxed text-grey-700">
                      <span class="mt-2.5 h-1 w-1 flex-none rounded-full bg-grey-400"></span>
                      <span>{entry}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>

        <div class="space-y-6">
          {item.media.map((row) =>
            row.length > 1 ? (
              <div class="grid items-start gap-6 sm:grid-cols-2">
                {row.map((image) => <PortfolioFigure image={image} />)}
              </div>
            ) : (
              <PortfolioFigure image={row[0]} />
            )
          )}
        </div>
      </div>
    </details>
  </div>
</article>

<style>
  /* Native <details>: no JavaScript needed, content stays in the HTML for crawlers. */
  .case-details > summary {
    list-style: none;
  }
  .case-details > summary::-webkit-details-marker {
    display: none;
  }
  .chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid #f15a24;
    border-bottom: 2px solid #f15a24;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }
  .case-details[open] .chevron {
    transform: rotate(45deg);
  }
  .label-close {
    display: none;
  }
  .case-details[open] .label-open {
    display: none;
  }
  .case-details[open] .label-close {
    display: inline;
  }
  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
