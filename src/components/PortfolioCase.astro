---
import type { PortfolioCase } from '../data/portfolio';
import PortfolioFigure from './PortfolioFigure.astro';

export interface Props {
  item: PortfolioCase;
  /** First case sits near the top of the page, so its lead image should not be lazy-loaded. */
  first?: boolean;
  /** Zero-based position; shown as 01, 02... and used to alternate the background. */
  index?: number;
}

const { item, first = false, index = 0 } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const alt = index % 2 === 1;
---

<article id={item.id} aria-labelledby={`${item.id}-title`} class:list={['case', { alt }]}>
  <div class="case-inner">
    <div class="case-top">
      <div>
        <p class="eyebrow case-meta">
          <span class="case-num">{number}</span>
          <span>{item.company}</span>
          {item.role && <span class="case-role">/ {item.role}</span>}
        </p>
        <h2 id={`${item.id}-title`} class="disp case-title">{item.title}</h2>
        <p class="case-outcome">{item.outcome}</p>
      </div>
      <PortfolioFigure image={item.lead} eager={first} />
    </div>

    <details class="case-details">
      <summary class="eyebrow">
        <span class="chevron" aria-hidden="true"></span>
        <span class="label-open">{item.toggleLabel}</span>
        <span class="label-close">Close</span>
      </summary>

      <div class="case-body">
        <div class="case-sections">
          {item.sections.map((section) => (
            <div>
              {section.label && <h3 class="eyebrow section-label">{section.label}</h3>}
              {section.text && <p class="copy">{section.text}</p>}
              {section.paragraphs && (
                <div class="copy-stack">{section.paragraphs.map((paragraph) => <p class="copy">{paragraph}</p>)}</div>
              )}
              {section.items && (
                <ul class="items">
                  {section.items.map((entry) => (
                    <li><span class="dot" aria-hidden="true"></span><span>{entry}</span></li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>

        <div class="case-media">
          {item.media.map((row) =>
            row.length > 1 ? (
              <div class="media-row">{row.map((image) => <PortfolioFigure image={image} />)}</div>
            ) : (
              <PortfolioFigure image={row[0]} />
            )
          )}
        </div>
      </div>
    </details>
  </div>
</article>

<style>
  .case { border-bottom: 1px solid #d9d7d0; scroll-margin-top: 24px; }
  .case.alt { background: #efede8; }
  .case-inner { max-width: 1240px; margin: 0 auto; padding: 72px 40px; }
  .case-top { display: grid; gap: 40px; align-items: center; }
  .case-meta { margin: 0 0 20px; font-size: 11px; color: #121212; display: flex; flex-wrap: wrap; gap: 4px 10px; }
  .case-num { color: #c4491b; font-weight: 700; }
  .case-role { color: #6b6a66; font-weight: 500; }
  .case-title {
    margin: 0; max-width: 560px; font-weight: 800; font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.06; letter-spacing: -0.035em; text-wrap: balance;
  }
  .case-outcome { margin: 24px 0 0; max-width: 540px; font-size: 18px; line-height: 1.6; color: #3a3a37; }

  .case-details { margin-top: 40px; }
  .case-details > summary {
    list-style: none; display: inline-flex; align-items: center; gap: 12px; cursor: pointer;
    font-size: 12px; color: #121212; transition: color 0.15s;
  }
  .case-details > summary::-webkit-details-marker { display: none; }
  .case-details > summary:hover { color: #c4491b; }
  .case-details > summary:focus-visible { outline: 2px solid #c4491b; outline-offset: 4px; }
  .chevron {
    width: 8px; height: 8px; border-right: 2px solid #c4491b; border-bottom: 2px solid #c4491b;
    transform: rotate(-45deg); transition: transform 0.2s ease;
  }
  .case-details[open] .chevron { transform: rotate(45deg); }
  .label-close { display: none; }
  .case-details[open] .label-open { display: none; }
  .case-details[open] .label-close { display: inline; }

  .case-body { margin-top: 48px; display: grid; gap: 48px; }
  .case-sections { display: flex; flex-direction: column; gap: 32px; }
  .section-label { margin: 0; font-size: 11px; color: #6b6a66; }
  .copy { margin: 8px 0 0; max-width: 560px; font-size: 17px; line-height: 1.65; color: #3a3a37; }
  .copy-stack { display: flex; flex-direction: column; gap: 16px; }
  .copy-stack .copy { margin: 0; }
  .items { margin: 12px 0 0; padding: 0; list-style: none; max-width: 560px; display: flex; flex-direction: column; gap: 10px; }
  .items li { display: flex; gap: 14px; font-size: 17px; line-height: 1.6; color: #3a3a37; }
  .dot { flex: none; width: 5px; height: 5px; margin-top: 11px; background: #c4491b; }
  .case-media { display: flex; flex-direction: column; gap: 24px; }
  .media-row { display: grid; gap: 24px; align-items: start; }

  @media (min-width: 900px) {
    .case-inner { padding: 96px 40px; }
    .case-top { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; }
    .case-body { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; }
    .media-row { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .case-inner { padding: 56px 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chevron { transition: none; }
  }
</style>
