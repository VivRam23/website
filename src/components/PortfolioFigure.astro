---
import type { PortfolioImage } from '../data/portfolio';

export interface Props {
  image: PortfolioImage;
  /** Load immediately (use for images visible without scrolling). */
  eager?: boolean;
}

const { image, eager = false } = Astro.props;
const style = image.maxWidth ? `max-width:${image.maxWidth}px` : undefined;
const loading = eager ? 'eager' : 'lazy';
---

<figure class="pf" style={style}>
  {image.href ? (
    <a href={image.href} target="_blank" rel="noopener" class="pf-link">
      <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading={loading} decoding="async" />
      <span class="pf-badge">{image.linkLabel} ↗<span class="sr-only"> (opens in a new tab)</span></span>
    </a>
  ) : image.staticSrc ? (
    <picture>
      <source media="(prefers-reduced-motion: reduce)" srcset={image.staticSrc} />
      <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading={loading} decoding="async" />
    </picture>
  ) : (
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading={loading} decoding="async" />
  )}
  {image.caption && <figcaption>{image.caption}</figcaption>}
</figure>

<style>
  .pf { margin: 0; }
  .pf img { display: block; width: 100%; height: auto; border: 1px solid #d9d7d0; background: #fff; }
  .pf-link { position: relative; display: block; text-decoration: none; }
  .pf-badge {
    position: absolute; left: 12px; bottom: 12px; padding: 10px 16px;
    background: #121212; color: #f7f6f2;
    font: 600 11px/1 'Inter', system-ui, sans-serif; letter-spacing: 0.16em; text-transform: uppercase;
    transition: background 0.15s;
  }
  .pf-link:hover .pf-badge { background: #c4491b; }
  figcaption { margin-top: 10px; font-size: 13px; line-height: 1.45; color: #6b6a66; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
