---
import { proofStats } from '../data/site';
---

<section class="border-b border-ink/10 bg-cream-alt">
  <div class="section-inner section !py-14 lg:!py-16">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-5">
      {proofStats.map((stat) => (
        <div>
          <p class="font-display text-3xl text-olive sm:text-4xl">{stat.value}</p>
          <p class="mt-2 text-sm leading-snug text-stone-600">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
