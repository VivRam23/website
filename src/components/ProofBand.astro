---
import { proofStats } from '../data/site';
---

<section class="border-b border-grey-200">
  <div class="section-inner section !py-16 lg:!py-20">
    <div class="grid grid-cols-2 gap-x-8 gap-y-12 border-t border-grey-200 pt-10 sm:grid-cols-5 sm:gap-x-6">
      {proofStats.map((stat, i) => (
        <div class:list={[i === proofStats.length - 1 ? 'col-span-2 sm:col-span-1' : '']}>
          <p class="whitespace-nowrap font-display text-3xl font-black text-orange sm:text-4xl">{stat.value}</p>
          <p class="mt-3 max-w-[22ch] text-sm leading-snug text-ink">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
