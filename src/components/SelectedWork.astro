---
import { selectedWork } from '../data/site';
---

<section class="border-b border-grey-200">
  <div class="section-inner section">
    <h2 class="max-w-xl text-4xl sm:text-5xl">Selected work</h2>

    <div class="mt-16 grid gap-14 sm:grid-cols-3 sm:gap-10">
      {selectedWork.map((item) => (
        <div class="flex flex-col items-start">
          <div class="flex h-14 items-center">
            {item.logo ? (
              <img src={item.logo} alt={item.logoAlt} class="h-9 w-auto max-w-[180px] object-contain object-left" loading="lazy" />
            ) : (
              <span class="text-xs font-semibold uppercase tracking-widest2 text-grey-500">
                {item.name} — logo pending
              </span>
            )}
          </div>
          {item.description ? (
            <p class="mt-6 text-base leading-relaxed text-grey-700">{item.description}</p>
          ) : (
            <p class="mt-6 text-base leading-relaxed text-grey-400">Description pending.</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
