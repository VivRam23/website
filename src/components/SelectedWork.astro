---
import { caseStudies } from '../data/site';
---

<section class="border-b border-ink/10">
  <div class="section-inner section">
    <p class="eyebrow">Selected work</p>
    <h2 class="mt-3 text-4xl sm:text-5xl">Proof, in three moves</h2>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {caseStudies.map((cs) => (
        <a
          href={`/work#${cs.slug}`}
          class="group flex flex-col rounded-sm border border-ink/10 bg-cream-alt p-7 transition-colors hover:border-olive/40"
        >
          <img src={cs.logo} alt={`${cs.name} logo`} class="h-8 w-auto object-contain object-left" loading="lazy" />
          <p class="mt-5 text-xs font-medium uppercase tracking-[0.1em] text-clay-600">{cs.role}</p>
          <h3 class="mt-2 text-xl leading-snug">{cs.theme}</h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/75">{cs.homepageSummary}</p>
          <ul class="mt-6 flex flex-wrap gap-x-3 gap-y-1 text-xs text-stone-600">
            {cs.tags.map((tag, i) => (
              <li>{tag}{i < cs.tags.length - 1 ? ' ·' : ''}</li>
            ))}
          </ul>
          <span class="mt-6 text-sm font-medium text-olive group-hover:underline">
            View case study →
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
