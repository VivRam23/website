---
import type { Service } from '../data/site';

export interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="grid gap-8 border-t border-grey-200 py-14 lg:grid-cols-[minmax(0,280px)_minmax(0,1fr)] lg:gap-16 lg:py-16">
  <div>
    <span class="font-display text-2xl font-black text-orange">{service.number}</span>
    <h2 class="mt-3 text-3xl leading-tight sm:text-4xl">{service.title}</h2>
  </div>

  <div class="max-w-2xl">
    <p class="text-2xl font-semibold leading-snug text-ink">{service.tagline}</p>
    <p class="mt-4 text-base leading-relaxed text-grey-700">{service.description}</p>

    <ul class="mt-8 grid gap-x-8 gap-y-2 sm:grid-cols-2">
      {service.capabilities.map((cap) => (
        <li class="flex gap-3 text-sm leading-relaxed text-grey-700">
          <span class="mt-2 h-1 w-1 flex-none rounded-full bg-grey-400"></span>
          <span>{cap}</span>
        </li>
      ))}
    </ul>
  </div>
</article>
