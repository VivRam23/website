---
import { services } from '../data/site';
---

<section class="border-b border-grey-200">
  <div class="section-inner section !pt-12 lg:!pt-16">
    <p class="eyebrow">Capabilities</p>
    <h2 class="mt-3 max-w-xl text-4xl sm:text-5xl">Where I come in</h2>

    <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <div class="border-t border-grey-200 pt-5">
          <span class="font-display text-sm font-bold text-orange">{service.number}</span>
          <h3 class="mt-2 text-xl font-semibold leading-snug">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-grey-600">{service.tagline}</p>
        </div>
      ))}
    </div>

    <a
      href="/services"
      class="mt-12 inline-block text-sm font-semibold text-ink underline decoration-orange decoration-2 underline-offset-4 hover:text-orange"
    >
      Explore how I can help →
    </a>
  </div>
</section>
