---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const title = 'About — Viviana Rames';
const description =
  'Viviana Rames is a marketing and go-to-market leader with 15+ years across B2B and B2C, building marketing functions from the ground up for climate and deep tech companies across Australia, North America and Europe, and founder of a sustainability business she scaled and exited.';
---

<BaseLayout title={title} description={description} path="/about">
  <section class="border-b border-grey-200">
    <div class="section-inner section">
      <p class="eyebrow">About</p>
      <h1 class="mt-3 text-5xl sm:text-6xl">Viviana Rames</h1>

      <div class="mt-12 grid gap-12 lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-16">
        <div class="flex flex-col items-start gap-5">
          <img
            src="/images/portrait.jpg"
            alt="Portrait of Viviana Rames"
            class="aspect-square w-full max-w-[240px] rounded-full object-cover"
            width="240"
            height="240"
          />
          <a
            href={site.linkedin}
            rel="me noopener"
            target="_blank"
            class="text-sm font-semibold text-ink hover:text-orange"
          >
            LinkedIn ↗
          </a>
          <a href={`mailto:${site.email}`} class="btn-primary">Let's talk</a>
        </div>

        <div class="max-w-2xl space-y-6 text-lg leading-relaxed text-grey-700">
          <p class="text-xl leading-relaxed text-ink">
            I lead marketing and go-to-market — 15+ years across B2B and B2C.
          </p>
          <p>
            Recently, that's meant climate and deep tech: turning complex capabilities into positioning, messaging and commercial programs that land with customers, partners and investors.
          </p>
          <p>
            I've built marketing functions from the ground up — leading teams, setting priorities, budgets and OKRs, and working closely with founders, technical, commercial and executive leaders across Australia, North America and Europe.
          </p>
          <p>
            That operator mindset comes from experience: I founded, scaled and exited my own sustainability business, and bring that same ownership to every team I lead.
          </p>
          <p>
            Strategy and execution, together — product marketing, communications, sales enablement, demand generation and events.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
