---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Challenge from '../components/Challenge.astro';
import ServicesPreview from '../components/ServicesPreview.astro';
import SelectedWork from '../components/SelectedWork.astro';
import ProofBand from '../components/ProofBand.astro';
import AboutSection from '../components/AboutSection.astro';
import FinalCta from '../components/FinalCta.astro';

const title = 'Viviana Rames — Marketing & GTM for complex products and emerging technologies';
const description =
  'Senior marketing and GTM operator specializing in complex products and emerging technologies. Fractional, interim and project-based leadership in positioning, product marketing, GTM strategy and communications — with deep credibility in climate and deep tech.';
---

<BaseLayout title={title} description={description} path="/">
  <Hero />
  <Challenge />
  <ServicesPreview />
  <SelectedWork />
  <ProofBand />
  <AboutSection />
  <FinalCta />
</BaseLayout>
