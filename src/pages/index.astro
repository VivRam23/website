---
import '../styles/global.css';
const title = 'Viviana Rames | Marketing for Complex Products';
const description = 'Marketing and go-to-market ownership for funded founders building complex or emerging technology. Clarity first, then traction, owned end to end.';
const canonical = 'https://www.vivrames.com/';
const ogImage = 'https://www.vivrames.com/images/og-default.jpg';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Viviana Rames',
  url: canonical,
  description,
  founder: { '@type': 'Person', name: 'Viviana Rames', sameAs: ['https://www.linkedin.com/in/vivianarames/'] },
  email: 'hello@vivrames.com',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,100..900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body style="margin:0;background:#F7F6F2;color:#121212;font-family:Inter,system-ui,sans-serif;">


<div style="font-family: 'Inter', system-ui, sans-serif; color: #121212; background: #F7F6F2; width: 100%;">

  <!-- NAV -->
  <header style="border-bottom: 1px solid #D9D7D0;">
    <div style="max-width: 1240px; margin: 0 auto; padding: 18px 40px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;">
      <a href="#top" class="navlink eyebrow" style="font-size: 15px; font-weight: 700; letter-spacing: 0.2em; color: #121212;">Viviana Rames</a>
      <nav aria-label="Main" style="display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px;">
        <a href="#proof" class="navlink eyebrow" style="color: #4A4A47;">Work</a>
        <a href="#how" class="navlink eyebrow" style="color: #4A4A47;">How I Work</a>
        <a href="#about" class="navlink eyebrow" style="color: #4A4A47;">About</a>
        <a href="#contact" class="navlink eyebrow" style="color: #4A4A47;">Contact</a>
        <a href="https://calendly.com/hello-vivrames/30min" target="_blank" rel="noopener" class="btn eyebrow" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; background: #C4491B; color: #FFFFFF; text-decoration: none; font-size: 13px;">Book a conversation</a>
      </nav>
    </div>
  </header>

  <!-- HERO -->
  <section id="top" style="position: relative; overflow: hidden; border-bottom: 1px solid #D9D7D0;">
    <div class="gridlayer" aria-hidden="true"></div>
    <div style="position: relative; max-width: 1240px; margin: 0 auto; padding: 128px 40px 120px;">
      <p class="eyebrow" style="margin: 0 0 36px; font-weight: 500; color: #6B6A66;">Marketing &amp; GTM for complex products and emerging technologies</p>
      <h1 class="disp" style="margin: 0; max-width: 1120px; font-weight: 800; font-stretch: 100%; font-size: clamp(38px, 5.4vw, 78px); line-height: 1.04; letter-spacing: -0.04em; text-wrap: balance;">As <span style="color: #E0653A;">commercially compelling</span> as you are technically strong.</h1>
      <p style="margin: 40px 0 0; max-width: 580px; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.55; color: #3A3A37;">Your product is strong. Growth still has to catch up. I build the foundation first, then run the motion that turns it into traction.</p>
      <div style="margin-top: 44px; display: flex; flex-wrap: wrap; align-items: center; gap: 20px 36px;">
        <a href="https://calendly.com/hello-vivrames/30min" target="_blank" rel="noopener" class="btn eyebrow" style="display: inline-flex; align-items: center; gap: 14px; min-height: 68px; padding: 0 36px; background: #C4491B; color: #FFFFFF; text-decoration: none; font-size: 15px;">Book a conversation <span aria-hidden="true">→</span></a>
      </div>
      <p style="margin: 18px 0 0; font-size: 14px; line-height: 1.5; color: #6B6A66;">30-minute fit check. Not a pitch.</p>
    </div>
  </section>

  <!-- PROOF STRIP -->
  <section aria-label="Track record" style="border-bottom: 1px solid #D9D7D0;">
    <div class="statgrid" style="max-width: 1240px; margin: 0 auto; padding: 0 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
      <div class="stat" style="padding: 36px 28px 36px 0; border-right: 1px solid #D9D7D0;">
        <div class="disp" style="font-weight: 800; font-stretch: 112%; font-size: 44px; line-height: 1.1; letter-spacing: -0.03em;">15+</div>
        <div style="margin-top: 8px; min-height: 42px; font-size: 14px; line-height: 1.5; color: #4A4A47;">years in marketing and go-to-market, from consumer to enterprise</div>
      </div>
      <div class="stat" style="padding: 36px 28px; border-right: 1px solid #D9D7D0;">
        <div class="disp" style="font-weight: 800; font-stretch: 112%; font-size: 44px; line-height: 1.1; letter-spacing: -0.03em;">2<span style="line-height: 0;">×</span> 0<span style="line-height: 0;">→</span>1</div>
        <div style="margin-top: 8px; min-height: 42px; font-size: 14px; line-height: 1.5; color: #4A4A47;">marketing functions built from the ground up</div>
      </div>
      <div class="stat" style="padding: 36px 28px; border-right: 1px solid #D9D7D0;">
        <div class="disp" style="font-weight: 800; font-stretch: 112%; font-size: 44px; line-height: 1.1; letter-spacing: -0.03em;">4<span style="line-height: 0;">×</span></div>
        <div style="margin-top: 8px; min-height: 42px; font-size: 14px; line-height: 1.5; color: #4A4A47;">monthly organic inbound enquiries within a year at a seed-stage climate tech company</div>
      </div>
      <div class="stat" style="padding: 36px 0 36px 28px;">
        <div class="disp" style="font-weight: 800; font-stretch: 112%; font-size: 44px; line-height: 1.1; letter-spacing: -0.03em;">250%</div>
        <div style="margin-top: 8px; min-height: 42px; font-size: 14px; line-height: 1.5; color: #4A4A47;">YoY growth in a company founded, scaled, and sold</div>
      </div>
    </div>
  </section>

  <!-- OPENING RECOGNITION -->
  <section style="background: #121212; color: #F7F6F2;">
    <div style="max-width: 1240px; margin: 0 auto; padding: 120px 40px;">
      <div style="width: 84px; height: 6px; background: #E0653A; margin-bottom: 32px;"></div>
      <h2 class="h2" style="max-width: 1000px;">You built something real. The product works. The technology holds up under pressure.</h2>
      <p class="disp" style="margin: 28px 0 0; max-width: 820px; font-weight: 400; font-size: clamp(24px, 2.6vw, 36px); line-height: 1.2; letter-spacing: -0.02em; color: #F2916B;">But the company does not land at the same level yet.</p>
      <div style="margin-top: 64px; display: flex; flex-wrap: wrap; gap: 40px 72px;">
        <div style="flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 22px;">
          <p class="body" style="color: #E4E2DA;">Investors need the long version before they get it. Sales conversations start from zero every time. The story has not caught up to what you built.</p>
          <p class="body" style="color: #E4E2DA;">You have become the explanation the company runs on, and that does not scale.</p>
        </div>
        <div style="flex: 1 1 380px; min-width: 0; border-left: 4px solid #E0653A; padding-left: 32px;">
          <p class="disp" style="margin: 0; font-weight: 700; font-size: clamp(22px, 2vw, 28px); line-height: 1.3; letter-spacing: -0.015em;">This closes that gap. First, a foundation clear enough to stand up to scrutiny. Then growth on top of it, until traction no longer depends on you in every room.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT CHANGES -->
  <section style="border-bottom: 1px solid #D9D7D0;">
    <div style="max-width: 1240px; margin: 0 auto; padding: 120px 40px;">
      <div style="margin-bottom: 56px;">
        <p class="eyebrow" style="margin: 0 0 20px; color: #6B6A66;">Three to six months in</p>
        <h2 class="h2">What changes.</h2>
      </div>
      <ol style="list-style: none; margin: 0; padding: 0; border-top: 2px solid #121212;">
        <li style="display: flex; gap: 28px; padding: 28px 0; border-bottom: 1px solid #D9D7D0; align-items: flex-start;">
          <span aria-hidden="true" style="flex: 0 0 28px; width: 28px; height: 4px; margin-top: 18px; background: #E0653A;"></span>
          <p class="disp" style="margin: 0; max-width: 900px; font-weight: 700; font-size: clamp(22px, 2.4vw, 34px); line-height: 1.2; letter-spacing: -0.02em;">The foundation runs in real conversations, not in a folder.</p>
        </li>
        <li style="display: flex; gap: 28px; padding: 28px 0; border-bottom: 1px solid #D9D7D0; align-items: flex-start;">
          <span aria-hidden="true" style="flex: 0 0 28px; width: 28px; height: 4px; margin-top: 18px; background: #E0653A;"></span>
          <p class="disp" style="margin: 0; max-width: 900px; font-weight: 700; font-size: clamp(22px, 2.4vw, 34px); line-height: 1.2; letter-spacing: -0.02em;">The product is clear to people who are not you.</p>
        </li>
        <li style="display: flex; gap: 28px; padding: 28px 0; border-bottom: 1px solid #D9D7D0; align-items: flex-start;">
          <span aria-hidden="true" style="flex: 0 0 28px; width: 28px; height: 4px; margin-top: 18px; background: #E0653A;"></span>
          <p class="disp" style="margin: 0; max-width: 900px; font-weight: 700; font-size: clamp(22px, 2.4vw, 34px); line-height: 1.2; letter-spacing: -0.02em;">Launches, communications and enablement move without you in the loop.</p>
        </li>
        <li style="display: flex; gap: 28px; padding: 28px 0; border-bottom: 1px solid #D9D7D0; align-items: flex-start;">
          <span aria-hidden="true" style="flex: 0 0 28px; width: 28px; height: 4px; margin-top: 18px; background: #E0653A;"></span>
          <p class="disp" style="margin: 0; max-width: 900px; font-weight: 700; font-size: clamp(22px, 2.4vw, 34px); line-height: 1.2; letter-spacing: -0.02em;">The right inbound starts to arrive.</p>
        </li>
        <li style="display: flex; gap: 28px; padding: 28px 0; border-bottom: 1px solid #D9D7D0; align-items: flex-start;">
          <span aria-hidden="true" style="flex: 0 0 28px; width: 28px; height: 4px; margin-top: 18px; background: #E0653A;"></span>
          <p class="disp" style="margin: 0; max-width: 900px; font-weight: 700; font-size: clamp(22px, 2.4vw, 34px); line-height: 1.2; letter-spacing: -0.02em;">Each deal, hire and quarter builds on the last.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section id="proof" style="background: #EFEDE8; border-bottom: 1px solid #D9D7D0;">
    <div style="max-width: 1240px; margin: 0 auto; padding: 120px 40px 112px;">
      <div style="margin-bottom: 56px;">
        <p class="eyebrow" style="margin: 0 0 20px; color: #6B6A66;">Selected work</p>
        <h2 class="h2" style="max-width: 860px;">Your company becomes as commercially clear as it is technically strong, so the right buyers get it without you re-explaining it in every room.</h2>
        <div style="margin-top: 36px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px;"><a href="https://calendly.com/hello-vivrames/30min" target="_blank" rel="noopener" class="btn eyebrow" style="display: inline-flex; align-items: center; gap: 14px; min-height: 60px; padding: 0 32px; background: #C4491B; color: #FFFFFF; text-decoration: none; font-size: 14px;">Book a conversation <span aria-hidden="true">→</span></a><p style="margin: 0; font-size: 14px; line-height: 1.5; color: #6B6A66;">30-minute fit check. Not a pitch. Not ready for the Seat? <a href="#how" style="color: #121212;">Start with the 4-week Foundation.</a></p></div>
      </div>

      <div style="display: flex; flex-direction: column; border-top: 2px solid #121212;">

        <article style="padding: 48px 0 52px; border-bottom: 1px solid #C9C7BF;">
          <p class="eyebrow" style="margin: 0 0 20px; font-size: 11px; color: #6B6A66;">Capture6 · First marketing hire, 0 to 1</p>
          <div style="display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: baseline; border-top: 6px solid #E0653A; padding-top: 18px;">
            <div class="disp" style="font-weight: 900; font-stretch: 125%; font-size: clamp(56px, 6vw, 88px); line-height: 0.95; letter-spacing: -0.05em; color: #121212;">4<span style="line-height: 0;">×</span></div>
            <h3 class="disp" style="margin: 0; flex: 1 1 380px; font-weight: 800; font-stretch: 110%; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.15; letter-spacing: -0.02em;">Organic inbound enquiries in a year, as the first marketing hire.</h3>
          </div>
          <div style="margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px 48px;">
            <div style="border-top: 1px solid #121212; padding-top: 16px;">
              <p class="eyebrow" style="margin: 0 0 10px; font-size: 11px; color: #6B6A66;">Foundation</p>
              <p style="margin: 0; font-size: 17px; line-height: 1.55;">Set positioning, brand and go-to-market priorities from zero.</p>
            </div>
            <div style="border-top: 1px solid #121212; padding-top: 16px;">
              <p class="eyebrow" style="margin: 0 0 10px; font-size: 11px; color: #6B6A66;">Execution</p>
              <p style="margin: 0; font-size: 17px; line-height: 1.55;">PR, executive thought leadership, events and sales enablement, earning coverage in Forbes and The Verge and a presence at COP28 and NY Climate Week.</p>
            </div>
          </div>
        </article>

        <article style="padding: 48px 0 52px; border-bottom: 1px solid #C9C7BF;">
          <p class="eyebrow" style="margin: 0 0 20px; font-size: 11px; color: #6B6A66;">Skytree · Messaging and event conversion</p>
          <div style="display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: baseline; border-top: 6px solid #E0653A; padding-top: 18px;">
            <div class="disp" style="font-weight: 900; font-stretch: 125%; font-size: clamp(56px, 6vw, 88px); line-height: 0.95; letter-spacing: -0.05em; color: #121212;">30%</div>
            <h3 class="disp" style="margin: 0; flex: 1 1 380px; font-weight: 800; font-stretch: 110%; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.15; letter-spacing: -0.02em;">Higher event lead-to-SQL conversion.</h3>
          </div>
          <div style="margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px 48px;">
            <div style="border-top: 1px solid #121212; padding-top: 16px;">
              <p class="eyebrow" style="margin: 0 0 10px; font-size: 11px; color: #6B6A66;">Foundation</p>
              <p style="margin: 0; font-size: 17px; line-height: 1.55;">A message house, and the market segmented into 11 industrial verticals.</p>
            </div>
            <div style="border-top: 1px solid #121212; padding-top: 16px;">
              <p class="eyebrow" style="margin: 0 0 10px; font-size: 11px; color: #6B6A66;">Execution</p>
              <p style="margin: 0; font-size: 17px; line-height: 1.55;">Eight events across three continents, webinars and sales enablement, with lead capture and nurture rebuilt in HubSpot.</p>
            </div>
          </div>
        </article>

        <article style="padding: 48px 0 52px; border-bottom: 1px solid #C9C7BF;">
          <p class="eyebrow" style="margin: 0 0 20px; font-size: 11px; color: #6B6A66;">OCA · 0 to 1 marketing function</p>
          <div style="display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: baseline; border-top: 6px solid #E0653A; padding-top: 18px;">
            <div class="disp" style="font-weight: 900; font-stretch: 125%; font-size: clamp(56px, 6vw, 88px); line-height: 0.95; letter-spacing: -0.05em; color: #121212;">2<span style="line-height: 0;">×</span></div>
            <h3 class="disp" style="margin: 0; flex: 1 1 380px; font-weight: 800; font-stretch: 110%; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.15; letter-spacing: -0.02em;">Revenue at roughly 150% ROMI, from a function built from zero.</h3>
          </div>
          <div style="margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px 48px;">
            <div style="border-top: 1px solid #121212; padding-top: 16px;">
              <p class="eyebrow" style="margin: 0 0 10px; font-size: 11px; color: #6B6A66;">Foundation</p>
              <p style="margin: 0; font-size: 17px; line-height: 1.55;">Built the marketing function from zero, with an integrated acquisition and retention strategy.</p>
            </div>
            <div style="border-top: 1px solid #121212; padding-top: 16px;">
              <p class="eyebrow" style="margin: 0 0 10px; font-size: 11px; color: #6B6A66;">Execution</p>
              <p style="margin: 0; font-size: 17px; line-height: 1.55;">Acquisition and retention across digital channels, run against quarterly OKRs and reported to the board.</p>
            </div>
          </div>
        </article>
      </div>

      <div style="margin-top: 56px; display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: flex-start;">
        <div style="flex: 1 1 420px; min-width: 0;">
          <p class="eyebrow" style="margin: 0 0 14px; font-size: 11px; color: #6B6A66;">Also</p>
          <p style="margin: 0; font-size: 16px; line-height: 1.65; color: #3A3A37;">A 10-person team and a ~$1.5M budget across four brands at Kaplan. Brush It On, founded and grown 250 percent year over year, then sold. Fractional work with Harvest Thermal on positioning, ICP, and content, and with Crbon Labs on rebrand and launch.</p>
        </div>
        <div style="flex: 1 1 420px; min-width: 0;">
          <p class="disp" style="margin: 0 0 12px; font-weight: 700; font-size: 20px; line-height: 1.3;">Different stages, same pattern: build the foundation, then grow on top of it.</p>
          <p style="margin: 0; font-size: 16px; line-height: 1.65; color: #3A3A37;">15+ years in marketing and go-to-market leadership. Two marketing functions built from zero. One company founded, scaled, and exited.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- HOW I WORK -->
  <section id="how" style="border-bottom: 1px solid #D9D7D0;">
    <div style="max-width: 1240px; margin: 0 auto; padding: 120px 40px;">
      <div style="width: 84px; height: 6px; background: #E0653A; margin-bottom: 28px;"></div>
      <p class="eyebrow" style="margin: 0 0 20px; color: #6B6A66;">How I work</p>
      <div style="display: flex; flex-wrap: wrap; gap: 32px 80px; align-items: flex-end;">
        <h2 class="disp" style="margin: 0; flex: 1 1 560px; font-weight: 900; font-stretch: 118%; font-size: clamp(40px, 5.6vw, 80px); line-height: 0.98; letter-spacing: -0.045em;">One path. Two ways in.</h2>
        <p class="body" style="flex: 1 1 420px; max-width: 520px; font-size: 18px; color: #3A3A37;">There is one path here, not a menu. You can start with the Foundation, or go straight to the Seat if you already know you need ownership now. Both lead to the same place: a company with a foundation strong enough to carry its own growth.</p>
      </div>

      <!-- SEAT -->
      <div style="margin-top: 72px; background: #121212; color: #F7F6F2;">
        <div style="padding: 48px 48px 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px;">
          <p class="eyebrow" style="margin: 0; color: #F2916B;">Seat first · Flagship</p>
          <p class="eyebrow" style="margin: 0; font-size: 11px; font-weight: 500; color: #B8B6AE;">If you already know you need someone to own this, start here.</p>
        </div>
        <div style="padding: 24px 48px 56px; display: flex; flex-wrap: wrap; gap: 48px 72px;">
          <div style="flex: 3 1 460px; min-width: 0;">
            <h3 class="disp" style="margin: 0; font-weight: 900; font-stretch: 118%; font-size: clamp(32px, 4vw, 52px); line-height: 1; letter-spacing: -0.04em;">The Clarity-to-Traction Seat</h3>
            <p style="margin: 28px 0 0; font-size: 18px; line-height: 1.6; color: #E4E2DA;">The multi-month path from a solid foundation to commercial traction, built on end-to-end ownership. Not advice. Not a deck. Someone in the seat, running it, for as long as it takes to turn the foundation into growth.</p>
            <p style="margin: 20px 0 0; font-size: 16px; line-height: 1.65; color: #C9C7BF;">First the foundation gets locked. Then the motion runs on top of it, shaped to fit what the business actually needs next. The Seat is ownership of the outcome, not a set of deliverables to tick off.</p>
            <p style="margin: 24px 0 0; padding-top: 16px; border-top: 1px solid #3A3A37; font-size: 13px; line-height: 1.6; color: #B8B6AE;">Where it shows up: communications, website and landing narrative, sales enablement, launches, market presence, demand motions.</p>
          </div>
          <div style="flex: 2 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 36px;">
            <!-- arc -->
            <div>
              <p class="eyebrow" style="margin: 0 0 20px; font-size: 11px; color: #B8B6AE;">The arc</p>
              <ol style="list-style: none; margin: 0; padding: 0;">
<li style="display: flex; gap: 20px; align-items: baseline; padding: 16px 0; border-top: 1px solid #3A3A37;"><span class="disp" style="flex: 0 0 28px; font-weight: 800; font-size: 16px; color: #E0653A;">01</span><span class="disp" style="font-weight: 800; font-size: 22px; letter-spacing: -0.01em;">Foundation locked</span></li>
<li style="display: flex; gap: 20px; align-items: baseline; padding: 16px 0; border-top: 1px solid #3A3A37;"><span class="disp" style="flex: 0 0 28px; font-weight: 800; font-size: 16px; color: #E0653A;">02</span><span class="disp" style="font-weight: 800; font-size: 22px; letter-spacing: -0.01em;">Motion in market</span></li>
<li style="display: flex; gap: 20px; align-items: baseline; padding: 16px 0; border-top: 1px solid #3A3A37; border-bottom: 1px solid #3A3A37;"><span class="disp" style="flex: 0 0 28px; font-weight: 800; font-size: 16px; color: #E0653A;">03</span><span class="disp" style="font-weight: 800; font-size: 22px; letter-spacing: -0.01em;">Traction</span></li>
</ol>
            </div>
            <dl style="margin: 0; border-top: 1px solid #3A3A37;">
              <div style="padding: 18px 0; border-bottom: 1px solid #3A3A37;"><dt class="eyebrow" style="font-size: 10px; color: #B8B6AE;">Length</dt><dd style="margin: 8px 0 0; font-size: 16px; line-height: 1.5;">3 to 6 months. Six is the ideal length to let the foundation hold, the motion run, and traction actually show up.</dd></div>
