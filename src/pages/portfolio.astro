---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioCase from '../components/PortfolioCase.astro';
import { site } from '../data/site';
import { portfolio } from '../data/portfolio';

const { meta, intro, cases, contact } = portfolio;
---

<BaseLayout title={meta.title} description={meta.description} path="/portfolio">
  <section class="border-b border-grey-200">
    <div class="section-inner section !pb-12 lg:!pb-14">
      <p class="eyebrow">{intro.eyebrow}</p>
      <h1 class="mt-3 max-w-2xl text-4xl sm:text-5xl">{intro.heading}</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-grey-700">{intro.text}</p>
    </div>
  </section>

  {cases.map((item, index) => <PortfolioCase item={item} first={index === 0} />)}

  <section class="bg-ink">
    <div class="section-inner section text-center !py-20">
      <h2 class="mx-auto max-w-2xl text-4xl leading-tight text-paper sm:text-5xl">{contact.heading}</h2>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a href={`mailto:${site.email}`} class="btn-primary">{site.email}</a>
        <a
          href={site.linkedin}
          rel="me noopener"
          target="_blank"
          class="text-sm font-semibold text-paper underline decoration-orange decoration-2 underline-offset-4 hover:text-orange"
        >
          LinkedIn ↗
        </a>
      </div>
      <p class="mx-auto mt-8 max-w-lg text-balance text-sm leading-relaxed text-grey-400">{contact.note}</p>
    </div>
  </section>
</BaseLayout>
