---
import PortfolioCase from '../components/PortfolioCase.astro';
import { portfolio } from '../data/portfolio';
import '../styles/global.css';

const { meta, intro, cases } = portfolio;
const canonical = 'https://www.vivrames.com/portfolio';
const ogImage = 'https://www.vivrames.com/images/og-default.jpg';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: meta.title,
  url: canonical,
  description: meta.description,
  author: { '@type': 'Person', name: 'Viviana Rames', sameAs: ['https://www.linkedin.com/in/vivianarames/'] },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,100..900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body style="margin:0;background:#F7F6F2;color:#121212;font-family:Inter,system-ui,sans-serif;">
    <header style="border-bottom: 1px solid #D9D7D0;">
      <div style="max-width: 1240px; margin: 0 auto; padding: 18px 40px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;">
        <p class="eyebrow" style="margin: 0; font-size: 15px; font-weight: 700; letter-spacing: 0.2em;">Viviana Rames</p>
      </div>
    </header>

    <main>
      <section style="position: relative; overflow: hidden; border-bottom: 1px solid #D9D7D0;">
        <div class="gridlayer" aria-hidden="true"></div>
        <div style="position: relative; max-width: 1240px; margin: 0 auto; padding: 112px 40px 96px;">
          <p class="eyebrow" style="margin: 0 0 32px; font-weight: 500; color: #6B6A66;">{intro.eyebrow}</p>
          <h1 class="disp" style="margin: 0; max-width: 900px; font-weight: 800; font-stretch: 100%; font-size: clamp(38px, 5.4vw, 78px); line-height: 1.04; letter-spacing: -0.04em; text-wrap: balance;">
            Selected <span style="color: #E0653A;">case studies.</span>
          </h1>
          <p style="margin: 36px 0 0; max-width: 580px; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.55; color: #3A3A37;">{intro.text}</p>
        </div>
      </section>

      {cases.map((item, index) => <PortfolioCase item={item} first={index === 0} index={index} />)}

      <section style="background: #121212; color: #F7F6F2;">
        <div style="max-width: 1240px; margin: 0 auto; padding: 112px 40px 104px;">
          <div style="width: 84px; height: 6px; background: #E0653A; margin-bottom: 32px;"></div>
          <h2 class="disp" style="margin: 0; max-width: 1040px; font-weight: 800; font-stretch: 100%; font-size: clamp(34px, 4.8vw, 68px); line-height: 1.04; letter-spacing: -0.04em; text-wrap: balance;">Let's talk.</h2>
          <p style="margin: 40px 0 0; display: flex; flex-wrap: wrap; gap: 12px 32px; font-size: 19px; line-height: 1.5;">
            <a href="mailto:hello@vivrames.com" style="color: #F7F6F2; text-decoration-color: #E0653A; text-decoration-thickness: 2px; text-underline-offset: 6px;">hello@vivrames.com</a>
            <a href="https://www.linkedin.com/in/vivianarames" rel="me noopener" target="_blank" style="color: #F7F6F2; text-decoration-color: #E0653A; text-decoration-thickness: 2px; text-underline-offset: 6px;">LinkedIn</a>
          </p>
        </div>
      </section>
    </main>

    <footer style="background: #121212; color: #B8B6AE; border-top: 1px solid #3A3A37;">
      <div style="max-width: 1240px; margin: 0 auto; padding: 32px 40px; display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; align-items: center;">
        <span class="eyebrow" style="font-size: 10px; font-weight: 500;">© 2026 Viviana Rames</span>
        <p class="eyebrow" style="margin: 0; font-size: 11px; font-weight: 500; display: flex; flex-wrap: wrap; gap: 12px 24px;">
          <a href="https://www.linkedin.com/in/vivianarames" rel="me noopener" target="_blank" style="color: #F7F6F2; text-underline-offset: 4px;">LinkedIn</a>
          <a href="mailto:hello@vivrames.com" style="color: #F7F6F2; text-underline-offset: 4px;">Email</a>
        </p>
      </div>
    </footer>
  </body>
</html>
